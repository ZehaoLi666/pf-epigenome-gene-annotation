# Copy to config/hpcc.env and edit. Sourced by every SLURM / shell job script:
#   export PF_REPO=/path/to/pf-epigenome-gene-annotation ; sbatch longread_reference/...
export PF_HPCC_BIGDATA=/path/on/cluster/bigdata     # work area for large intermediate files
export PF_HPCC_LAB=/path/on/cluster/lab             # raw data (SRA downloads, PlasmoDB genome files)
export PF_HPCC_HOME=/path/on/cluster/home           # home directory (conda environments)
export PF_LAB_DIR=/path/to/Lab                      # only for scripts that also run locally
mkdir -p logs                                       # SLURM --output paths are relative (logs/)
